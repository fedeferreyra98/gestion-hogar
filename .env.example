# Copiar a .env (make setup lo hace automáticamente). .env NO se commitea.
DB_NAME=hogar
DB_USER=hogar
DB_PASSWORD=hogar
DB_PORT=5432

# Backend (perfil Spring "local")
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080
JWT_SECRET=dev-only-secret-change-me-dev-only-secret-change-me
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Frontend
VITE_API_URL=http://localhost:8080/api/v1

# Credenciales del owner de desarrollo (las usa `make seed` y scripts/smoke.sh)
DEV_OWNER_EMAIL=owner@hogar.local
DEV_OWNER_PASSWORD=owner-password-123
DEV_OWNER_NAME=OwnerDev
DEV_HOUSEHOLD_NAME=HogarDev
